# Copy to .env. Paper mode (the default) needs nothing else: it reads public market data.
PAPER_MODE=true

# ── Live trading (PAPER_MODE=false): real orders with real money on your Binance spot account ──
# The bot refuses to start live unless all three values below are set AND the strategy passes its
# gate (a 365-day backtest with fees, Sharpe above 1.0 over at least 20 trades).
# Check readiness first with:  python backend/check_live.py
#
# Create the key in Binance > Account > API Management: enable "Spot & Margin Trading",
# keep withdrawals OFF, and restrict it to your IP address if you can. Never share these values.
BINANCE_API_KEY=
BINANCE_SECRET=

# The most USDT the bot may put into a trade, even if your account holds more.
MAX_CAPITAL_USDT=
